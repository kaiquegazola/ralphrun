{
  "name": "ralphrun-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ralphrun mission-control — Electrobun desktop app over the ralphrun core.",
  "scripts": {
    "build:child": "bun run scripts/build-child.ts",
    "dev": "bun run build:child && electrobun dev",
    "build": "bun run build:child && electrobun build --env=canary",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "electrobun": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
